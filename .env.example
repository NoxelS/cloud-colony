# Local development. Existing process environment variables take precedence.
# Include the /v1 API prefix in the LiteLLM endpoint URL.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=

# Optional. Set the origin clients use to reach the agent when running outside localhost.
# PORT=8080
# A2A_BASE_URL=http://127.0.0.1:8080

# Optional Lens tracing. Use the HTTPS hostname when DNS is available, or port-forward Lens locally.
# LENS_OTLP_ENDPOINT=https://lens.noel.fyi/v1/traces
# LITELLM_TRACING_KEY=
