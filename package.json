{
  "name": "@cloud-colony/bootstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development and delivery foundation for self-hosted cloud agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoxelS/cloud-colony.git"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:infra": "node scripts/lint-infra.mjs",
    "check:container": "node scripts/container-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
